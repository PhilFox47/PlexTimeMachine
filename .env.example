# ---------------------------------------------------------------------------
# Plex Time Machine – Konfiguration
# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ---------------------------------------------------------------------------

# Basis-URL des Plex Media Servers (ohne abschliessenden Slash)
PTM_PLEX_BASEURL=http://192.168.1.10:32400

# Admin-Token des Plex-Servers.
# Auslesen: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PTM_PLEX_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Wie lange auf Plex gewartet wird, bevor abgebrochen wird (Sekunden).
PTM_PLEX_TIMEOUT_SECONDS=10

# Namen der Bibliotheken (exakt wie in Plex benannt).
PTM_MOVIE_LIBRARY=Filme
PTM_TV_LIBRARY=Serien

# Name der Zeitreise-Playlist. "{weekday}" und "{date}" stammen vom ältesten
# Titel, der noch in der Playlist steckt – der Name wandert also mit, sobald der
# erste Tag weggesehen ist. "{user}" ist das Profil, falls es im Namen stehen
# soll. Wer die Zeile aus einer älteren Fassung übernommen hat, sollte sie
# ersetzen – sonst gilt weiter das alte Schema.
PTM_PLAYLIST_NAME_TEMPLATE={weekday} - {date} - Time Machine

# Name der Almanach-Playlists: "{name}" ist der Name der Sammlung, "{user}" das
# Profil. Wer die Zeile aus einer älteren Fassung übernommen hat, sollte sie
# ersetzen – sonst gilt weiter das alte Schema.
PTM_ALMANACH_PLAYLIST_NAME_TEMPLATE={name} – {user} – Almanach

# Periodisches Polling in Minuten (0 = deaktiviert).
PTM_POLL_INTERVAL_MINUTES=30

# Verzögerung in Sekunden, mit der ein Webhook-Event einen Re-Sync auslöst
# (mehrere Events kurz hintereinander werden zu einem Sync zusammengefasst).
PTM_WEBHOOK_DEBOUNCE_SECONDS=20

# Optionales gemeinsames Geheimnis für den Webhook-Endpoint.
# Wenn gesetzt, muss Plex auf /webhook/plex?token=<wert> zeigen.
PTM_WEBHOOK_TOKEN=

# Speicherort der SQLite-Datenbank.
PTM_DATABASE_URL=sqlite:///./data/plex_time_machine.db

# Ablage der Cover-Bilder für die Playlists.
PTM_COVER_DIR=./data/covers

# Maximale Größe eines Cover-Bildes in Bytes (Standard: 5 MB).
PTM_COVER_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# Übergangsclips zwischen den Tagen der Zeitreise-Playlist (optional)
# ---------------------------------------------------------------------------

# Erst einschalten, wenn die Plex-Bibliothek unten existiert.
PTM_TRANSITIONS_ENABLED=false

# Ordner für die erzeugten Clips. Genau diesen Ordner in Plex als Bibliothek
# vom Typ "Andere Videos" anlegen.
PTM_TRANSITION_DIR=./data/transitions

# Name dieser Bibliothek in Plex (exakt wie dort benannt).
PTM_TRANSITION_LIBRARY=Zeitreise-Übergänge

# Höchstens so viele Clips je Lauf (7 = eine Woche).
PTM_TRANSITION_MAX_CLIPS=7

# Nur für dieses Profil werden Clips erzeugt (leer = für alle). Rendern kostet
# Minuten, deshalb lohnt es sich, das auf das Hauptprofil zu beschränken.
PTM_TRANSITION_USER=Zeitreisende Ente

# Pause nach dem Rendern, bevor Plex eingelesen und die Playlist neu gebaut
# wird. Plex braucht für frisch geschriebene Dateien etwas Ruhe.
PTM_TRANSITION_SCAN_DELAY_SECONDS=300

# Auflösung: 1080 oder 720 (720 rendert etwa dreimal schneller).
PTM_TRANSITION_HEIGHT=1080

# Maximale Anzahl Items in der Vorschau-Tabelle (0 = unbegrenzt).
PTM_PREVIEW_LIMIT=400

# Zeitzone für Scheduler und Logbuch-Anzeige.
TZ=Europe/Berlin
